# Application Environment: development | production | test
NODE_ENV=development
LOG_LEVEL=info

# Telegram Bot Configuration
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
# Comma-separated Telegram User IDs of administrators
ADMIN_IDS=123456789,987654321

# Bot Mode: polling | webhook
BOT_MODE=polling
WEBHOOK_DOMAIN=https://bot.yourdomain.com
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=super_secret_webhook_token_12345
PORT=3000

# PostgreSQL Database (Drizzle ORM)
POSTGRES_USER=vocab_user
POSTGRES_PASSWORD=vocab_secret_password
POSTGRES_DB=vocab_bot_db
DATABASE_URL=postgresql://vocab_user:vocab_secret_password@localhost:5432/vocab_bot_db

# Redis (Session, Game State, Rate Limiter, BullMQ Reminders)
REDIS_URL=redis://localhost:6379

# Timezone for Daily Streak & Reminder Calculations
DEFAULT_TIMEZONE=Asia/Tashkent

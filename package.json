{
  "name": "uzbek-english-vocab-bot",
  "version": "1.0.0",
  "description": "Production Telegram bot for Uzbek speakers to learn English vocabulary with SRS, quizzes, and mini-games",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:local": "tsx src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/i18n/locales',{recursive:true});fs.copyFileSync('src/i18n/locales/uz.ftl','dist/i18n/locales/uz.ftl')\"",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.0.1",
    "@grammyjs/i18n": "^1.1.0",
    "@grammyjs/menu": "^1.3.0",
    "@grammyjs/parse-mode": "^1.11.1",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/storage-redis": "^2.5.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "bullmq": "^5.34.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "grammy": "^1.33.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "vitest": "^2.1.8"
  }
}
